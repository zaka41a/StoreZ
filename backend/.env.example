# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/storez
SPRING_DATASOURCE_USERNAME=storez
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# JWT Configuration
# Generate a secure secret key (min 256 bits / 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=your_very_long_and_secure_secret_key_here_min_256_bits

# File Upload Configuration
UPLOAD_DIR=./uploads

# Server Configuration (Optional)
SERVER_PORT=8080

# Application Profile
SPRING_PROFILES_ACTIVE=dev

# Logging Level (Optional)
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_STOREZ=DEBUG
